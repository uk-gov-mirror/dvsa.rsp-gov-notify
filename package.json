{
  "name": "rsp-gov-notify",
  "version": "4.0.0",
  "description": "Service to send notifications to users of the RSP project using Gov.Notify.",
  "repository": "https://github.com/dvsa/rsp-gov-notify",
  "author": "DVSA",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0",
    "npm": "^11.12.1"
  },
  "scripts": {
    "build-openapi": "mkdir -p build && sls openapi generate -f json -o build/openapi.json",
    "prepush": "npm test && npm run lint && npm run check-security",
    "check-security": "git secrets --scan",
    "check-security-log": "git log -p | scanrepo",
    "test": "./node_modules/.bin/mocha --require @babel/register src/**/*.unit.js",
    "test-watch": "nodemon --watch src --exec npm test",
    "lint": "./node_modules/.bin/eslint src",
    "lint:fix": "./node_modules/.bin/eslint src --fix",
    "watch": "./node_modules/.bin/nodemon --watch src --exec npm run build",
    "offline": "sls offline start --noAuth",
    "parallel": "./node_modules/.bin/run-p watch offline",
    "build": "webpack-cli --config webpack.config.js",
    "start": "rm -rf .webpack && npm run build && npm run parallel",
    "build:prod": "rm -rf dist .webpack && webpack-cli --config webpack.production.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.0.6",
    "archiver": "^8.0.0",
    "babel-loader": "^10.1.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "expect": "^30.5.2",
    "fs-extra": "^11.4.1",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "osls": "^4.4.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.8.4",
    "serverless-openapi-documenter": "^0.1.7",
    "sinon": "^22.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "notifications-node-client": "^8.5.0"
  },
  "overrides": {
    "serverless": "npm:osls"
  }
}
